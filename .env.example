# Copy this file to .env and fill in real values. Never commit .env.
#
# --- Required for any real (non-mocked) pipeline run ---
OPENAI_API_KEY=

# --- Optional: raises GitHub API rate limits when fetching issues by URL ---
GITHUB_TOKEN=

# --- Fine-tuned Llama-3 serving (agents/nodes/llama_coder_agent.py) ---
# LLAMA_BACKEND=ollama for local dev, =vllm for production
LLAMA_BACKEND=ollama
LLAMA_SERVER_URL=http://localhost:11434
LLAMA_MODEL_NAME=swe-llama3-qlora
LLAMA_BASE_FALLBACK=llama3:8b-instruct

# --- Retrieval embeddings (retrieval/code_indexer.py) ---
# auto = openai if OPENAI_API_KEY set, else local sentence-transformers
EMBEDDING_BACKEND=auto
INDEX_CACHE_ROOT=.index_cache

# --- Patch ranker (patch_ranking/patch_ranker_model.py) ---
# Path to a trained .pkl; if unset/missing, falls back to a hand-weighted heuristic
PATCH_RANKER_MODEL_PATH=patch_ranking/ranker_model.pkl

# --- Sandbox (sandbox/docker_executor.py) ---
SANDBOX_TIMEOUT_SECONDS=60

# --- Experiment tracking ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=multi-agent-swe-system
MLFLOW_TRACKING_URI=http://localhost:5000

# --- Backend CORS ---
CORS_ORIGINS=http://localhost:5173
